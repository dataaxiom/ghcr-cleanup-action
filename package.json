{
  "name": "ghcr-cleanup-action",
  "description": "GitHub Container Registry Cleanup Action",
  "version": "main",
  "author": "Dataaxiom Inc",
  "homepage": "https://github.com/dataaxiom/ghcr-cleanup-action",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dataaxiom/ghcr-cleanup-action.git"
  },
  "bugs": {
    "url": "https://github.com/dataaxiom/ghcr-cleanup-action/issues"
  },
  "keywords": [
    "ci",
    "ghcr.io"
  ],
  "exports": {
    ".": "./dist/index.js"
  },
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "scripts": {
    "bundle": "npm run format:write && npm run package && npm run ci-tester",
    "ci-test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage && npx make-coverage-badge --output-path ./badges/coverage.svg",
    "format:write": "npx prettier --write .",
    "format:check": "npx prettier --check .",
    "lint": "npx eslint .",
    "package": "npx ncc build src/index.ts -o dist --source-map --license licenses.txt",
    "ci-tester": "npx ncc build src/ci-tester.ts -o citester --source-map",
    "package:watch": "npm run package -- --watch",
    "test": "vitest run",
    "all": "npm run format:write && npm run lint && npm run test && npm run package",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,js,json,md,yml,yaml}": "prettier --write"
  },
  "license": "BSD-3-Clause",
  "dependencies": {
    "@actions/cache": "~6.2.0",
    "@actions/core": "^3.0.1",
    "@octokit/auth-token": "^6.0.0",
    "@octokit/plugin-request-log": "^6.0.0",
    "@octokit/plugin-retry": "^8.1.1",
    "@octokit/plugin-throttling": "^11.0.5",
    "@octokit/request-error": "^7.1.2",
    "@octokit/rest": "^22.0.1",
    "axios": "^1.21.1",
    "axios-logger": "^2.8.1",
    "axios-retry": "^4.5.0",
    "human-interval": "^2.0.1",
    "safe-regex2": "^5.1.2",
    "wildcard-match": "^5.1.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vercel/ncc": "^0.45.0",
    "@vitest/coverage-v8": "^4.1.12",
    "@vitest/eslint-plugin": "^1.6.28",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-github": "^6.1.2",
    "eslint-plugin-jsonc": "^3.4.2",
    "eslint-plugin-prettier": "^5.5.7",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "make-coverage-badge": "^1.2.0",
    "prettier": "^3.9.10",
    "stdio": "^2.1.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "@azure/storage-blob": "12.33.0"
  }
}
